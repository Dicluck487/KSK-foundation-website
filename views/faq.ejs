<!-- =========================================================
     FAQ PAGE
========================================================= -->

<section class="page-header faq-page-header">

  <div class="container">

    <span class="section-eyebrow">
      QUESTIONS & ANSWERS
    </span>

    <h1>Frequently Asked Questions</h1>

    <p>
      Find answers to some of the questions we receive most
      often about KSK Foundation, our programs and how to get
      involved.
    </p>

  </div>

</section>


<!-- =========================================================
     FAQ
========================================================= -->

<section class="section faq-section">

  <div class="container">

    <div class="faq-layout">


      <!-- INTRO -->

      <div class="faq-intro">

        <span class="section-eyebrow">
          NEED TO KNOW?
        </span>

        <h2>
          We've got answers.
        </h2>

        <p>
          Whether you are a prospective participant, parent,
          alumnus, partner or sponsor, here are some of the
          questions you may have.
        </p>

        <a
          href="/contact-us"
          class="btn btn-primary"
        >
          Still Have Questions?
        </a>

      </div>


      <!-- QUESTIONS -->

      <div class="faq-list">


        <!-- QUESTION 1 -->

        <article class="faq-item">

          <button
            class="faq-question"
            type="button"
            aria-expanded="false"
          >

            <span>
              How do I apply to a program?
            </span>

            <span class="faq-icon">
              +
            </span>

          </button>

          <div class="faq-answer">

            <p>
              Applications open on a rolling basis ahead of each
              program's intake window. Secondary schools may
              nominate S6 leavers for the Making Students World
              Ready Program (MSWRP), while families can apply
              directly for Kaizen Teen Boot Camp. Please contact
              KSK Foundation to confirm the exact application
              process and any available application form before
              applying.
            </p>

          </div>

        </article>


        <!-- QUESTION 2 -->

        <article class="faq-item">

          <button
            class="faq-question"
            type="button"
            aria-expanded="false"
          >

            <span>
              Is there a cost to participate?
            </span>

            <span class="faq-icon">
              +
            </span>

          </button>

          <div class="faq-answer">

            <p>
              Participation costs, sponsorship arrangements and
              any need-based waivers vary by program. Please
              contact KSK Foundation for the most current
              information about fees and available support before
              applying.
            </p>

          </div>

        </article>


        <!-- QUESTION 3 -->

        <article class="faq-item">

          <button
            class="faq-question"
            type="button"
            aria-expanded="false"
          >

            <span>
              How can my organization sponsor a program?
            </span>

            <span class="faq-icon">
              +
            </span>

          </button>

          <div class="faq-answer">

            <p>
              Visit our
              <a href="/partner-with-us">
                Partner With Us
              </a>
              page to learn about sponsorship opportunities,
              or contact us directly to discuss a partnership
              tailored to your organization's interests.
            </p>

          </div>

        </article>


        <!-- QUESTION 4 -->

        <article class="faq-item">

          <button
            class="faq-question"
            type="button"
            aria-expanded="false"
          >

            <span>
              How do I apply for a KSK Foundation scholarship?
            </span>

            <span class="faq-icon">
              +
            </span>

          </button>

          <div class="faq-answer">

            <p>
              KSK Foundation scholarship beneficiaries are
              identified through school nominations rather than
              applying directly for the scholarships. Please
              contact the Foundation if you would like to learn
              more about the scholarship partnerships and
              selection process.
            </p>

          </div>

        </article>


        <!-- QUESTION 5 -->

        <article class="faq-item">

          <button
            class="faq-question"
            type="button"
            aria-expanded="false"
          >

            <span>
              Where can I read FOCUS Magazine?
            </span>

            <span class="faq-icon">
              +
            </span>

          </button>

          <div class="faq-answer">

            <p>
              Current and past digital issues of FOCUS Magazine
              are available on our
              <a href="/publications">
                Publications
              </a>
              page as they become available.
            </p>

            <p>
              Hard-copy issues are available for UGX 20,000,
              subject to availability.
            </p>

          </div>

        </article>


      </div>

    </div>

  </div>

</section>


