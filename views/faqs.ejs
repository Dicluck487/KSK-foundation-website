<section class="page-header">
  <div class="container">
    <h1>FAQs</h1>
    <p>Frequently asked questions about the mentorship program.</p>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="accordion">
      <% faqs.forEach(function(item, i) { %>
        <div class="accordion-item">
          <button class="accordion-toggle" data-target="faq-<%= i %>"><%= item.q %></button>
          <div class="accordion-content" id="faq-<%= i %>">
            <p><%= item.a %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>
