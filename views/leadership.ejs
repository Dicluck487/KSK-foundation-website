<style>

  /* =========================================================
     PAGE HEADER
  ========================================================= */

  .leadership-header {
  position: relative;
  overflow: hidden;

  background-image:
    linear-gradient(110deg,  rgba(20, 22, 26, 0.97), rgba(20, 22, 26, 0.88),rgba(110, 2, 87, 0.72)),
    url('/images/lead2.jpg');
     
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.leadership-header .section-eyebrow {
  color: rgba(255,255,255,0.85);
}

.leadership-header h1 {
  color: #eba852;
}


.leadership-header p {
  color: #f7f5f2;
}


/* =========================================================
   HEADER TEXT ANIMATION
========================================================= */

.leadership-header .section-eyebrow,
.leadership-header h1,
.leadership-header p {
  opacity: 0;
  transform: translateY(24px);
  animation: headerFadeUp 0.8s ease forwards;
}

.leadership-header .section-eyebrow {
  animation-delay: 0.1s;
}

.leadership-header h1 {
  animation-delay: 0.25s;
}

.leadership-header p {
  animation-delay: 0.4s;
}

@keyframes headerFadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

  /* =========================================================
     SHARED
  ========================================================= */

  .section-eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary, #e0392c);
    
  }

  .section-heading {
    max-width: 760px;
