  }

  .section-heading p {
    margin: 0;
    color: var(--color-muted, #6b7280);
    line-height: 1.8;
  }


  /* =========================================================
     INTRO
  ========================================================= */

  .leadership-intro {
    padding-bottom: 40px;
  }

