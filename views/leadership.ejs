<script>
  (function () {
    var track = document.getElementById('board-timeline');
    var fill = document.getElementById('board-timeline-fill');

    if (!track || !fill) return;

    function updateTimelineFill() {
      var rect = track.getBoundingClientRect();
      var viewportH = window.innerHeight || document.documentElement.clientHeight;

      // Progress goes from 0 (section just entering the bottom of the
      // viewport) to 1 (section has fully passed the top of the viewport).
      var total = rect.height + viewportH;
      var scrolled = viewportH - rect.top;
      var progress = scrolled / total;

      progress = Math.max(0, Math.min(1, progress));

      fill.style.height = (progress * 100) + '%';
    }

    window.addEventListener('scroll', updateTimelineFill, { passive: true });
    window.addEventListener('resize', updateTimelineFill);
    updateTimelineFill();
  })();
</script>


