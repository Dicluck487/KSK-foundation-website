<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Alumni Voices | KSK Foundation</title>

    <meta
        name="description"
        content="Hear from KSK Foundation alumni and discover how our programs continue to shape young Ugandans."
    >

    <style>
        /* =========================================================
           KSK FOUNDATION — ALUMNI VOICES
        ========================================================= */

        :root {
            --primary: #6e0257;
            --primary-dark: #4f0340;
            --teal: #056b83;
            --dark: #14161a;
            --dark-2: #1e2126;
            --text: #25262a;
            --muted: #6d7178;
            --light: #f6f5f3;
            --white: #ffffff;
            --border: #e7e7e7;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
            color: var(--text);
            background: #fff;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            max-width: 100%;
        }

        .container {
            width: min(1180px, calc(100% - 40px));
            margin: 0 auto;
        }


        /* =========================================================
           HERO
        ========================================================= */

        .alumni-hero {

            .contact-page-header {
  /* position: relative;
  overflow: hidden; */
  background-image:
    /* linear-gradient(135deg, rgba(97, 6, 100, 0.78), rgba(238, 74, 230, 0.55)), */
    url('/images/contact.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

            position: relative;
            overflow: hidden;

            min-height: 430px;

            display: flex;
            align-items: center;

            background:
                linear-gradient(
                    110deg,
                    rgba(20, 22, 26, 0.97),
                    rgba(20, 22, 26, 0.88),
                    rgba(110, 2, 87, 0.72)
                );
        }

        .alumni-hero::before {
            content: "";

            position: absolute;
            inset: 0;

            background:
                radial-gradient(
                    circle at 80% 20%,
                    rgba(255,255,255,0.09),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 20% 80%,
                    rgba(110,2,87,0.2),
                    transparent 35%
                );
        }

        .hero-content {
            position: relative;
            z-index: 2;

            max-width: 760px;

            padding: 75px 0;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;

            margin-bottom: 18px;

            color: #e8b9dd;

            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .hero-eyebrow::before {
            content: "";

            width: 35px;
            height: 2px;

            background: #e8b9dd;
        }

        .hero-content h1 {
            margin: 0 0 20px;

            color: #fff;

            font-size: clamp(2.6rem, 6vw, 5rem);
            line-height: 0.98;
            letter-spacing: -0.04em;
        }

        .hero-content h1 span {
            color: #dca6d0;
        }

        .hero-content p {
            max-width: 650px;

            margin: 0;

            color: rgba(255,255,255,0.72);

            font-size: 1.05rem;
            line-height: 1.8;
        }


        /* =========================================================
           YEAR NAVIGATION
        ========================================================= */

        .year-navigation {
            position: sticky;
            top: 0;
            z-index: 20;

            background: rgba(255,255,255,0.96);

            border-bottom: 1px solid var(--border);

            backdrop-filter: blur(12px);
        }

        .year-nav-inner {
            display: flex;
            align-items: center;
            justify-content: center;

            gap: 8px;

            padding: 12px 0;
        }

        .year-nav-inner a {
            padding: 8px 20px;

            border-radius: 100px;

            color: var(--muted);

            font-size: 0.85rem;
            font-weight: 700;

            transition:
                background 0.2s ease,
                color 0.2s ease;
        }

        .year-nav-inner a:hover,
        .year-nav-inner a.active {
            background: var(--primary);
            color: #fff;
        }


        /* =========================================================
           INTRO
        ========================================================= */

        .alumni-intro {
            padding: 80px 0 55px;

            text-align: center;
        }

        .section-eyebrow {
            display: block;

            margin-bottom: 10px;

            color: var(--primary);

            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }

        .alumni-intro h2 {
            max-width: 720px;

            margin: 0 auto 16px;

            color: var(--dark);

            font-size: clamp(2rem, 4vw, 3.1rem);
            line-height: 1.1;
            letter-spacing: -0.03em;
        }

        .alumni-intro p {
            max-width: 680px;

            margin: 0 auto;

            color: var(--muted);

            font-size: 0.98rem;
        }


        /* =========================================================
           YEAR SECTIONS
        ========================================================= */

        .year-section {
            padding: 65px 0;

            scroll-margin-top: 70px;
        }

        .year-section:nth-child(even) {
            background: var(--light);
        }

        .year-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;

            gap: 30px;

            margin-bottom: 30px;
        }

        .year-title {
            display: flex;
            align-items: center;

            gap: 15px;
        }

        .year-title span {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 45px;
            height: 45px;

            border-radius: 50%;

            background: var(--primary);

            color: #fff;

            font-size: 0.72rem;
            font-weight: 800;
        }

        .year-title h2 {
            margin: 0;

            color: var(--dark);

            font-size: 2.1rem;
            line-height: 1;
        }

        .year-description {
            max-width: 430px;

            margin: 0;

            color: var(--muted);

            font-size: 0.88rem;
        }


        /* =========================================================
           TESTIMONIAL CARDS
        ========================================================= */

        .alumni-grid {
            display: grid;

            grid-template-columns:
                repeat(3, minmax(0, 1fr));

            gap: 22px;
        }

        .alumni-card {
            overflow: hidden;

            display: flex;
            flex-direction: column;

            background: #fff;

            border: 1px solid var(--border);

            border-radius: 16px;

            box-shadow:
                0 8px 30px rgba(0,0,0,0.04);

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }

        .alumni-card:hover {
            transform: translateY(-5px);

            box-shadow:
                0 18px 40px rgba(0,0,0,0.09);
        }


        /* =========================================================
           CARD IMAGE
        ========================================================= */

        .alumni-photo {
            position: relative;

            height: 270px;

            overflow: hidden;

            background: #ddd;
        }

        .alumni-photo img {
            width: 100%;
            height: 100%;

            display: block;

            object-fit: cover;
            object-position: center top;

            transition: transform 0.5s ease;
        }

        .alumni-card:hover .alumni-photo img {
            transform: scale(1.04);
        }

        .year-badge {
            position: absolute;

            top: 15px;
            left: 15px;

            padding: 6px 11px;

            border-radius: 100px;

            background: rgba(20,22,26,0.82);

            color: #fff;

            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 0.08em;
        }


        /* =========================================================
           CARD CONTENT
        ========================================================= */

        .alumni-card-content {
            display: flex;
            flex-direction: column;

            flex: 1;

            padding: 25px;
        }

        .alumni-program {
            margin-bottom: 8px;

            color: var(--primary);

            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .alumni-card h3 {
            margin: 0 0 3px;

            color: var(--dark);

            font-size: 1.2rem;
            line-height: 1.25;
        }

        .alumni-role {
            display: block;

            margin-bottom: 18px;

            color: #96999f;

            font-size: 0.76rem;
        }

        .alumni-quote {
            position: relative;

            margin: 0;

            padding-left: 18px;

            color: #555a61;

            font-size: 0.87rem;
            line-height: 1.7;

            font-style: italic;
        }

        .alumni-quote::before {
            content: "";

            position: absolute;

            top: 3px;
            left: 0;

            width: 3px;
            height: calc(100% - 6px);

            border-radius: 5px;

            background: var(--primary);
        }

        .alumni-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 10px;

            margin-top: 22px;
            padding-top: 15px;

            border-top: 1px solid var(--border);
        }

        .alumni-card-footer span {
            color: #999;

            font-size: 0.68rem;
        }

        .read-more {
            color: var(--primary);

            font-size: 0.7rem;
            font-weight: 800;

            text-transform: uppercase;
            letter-spacing: 0.06em;
        }


        /* =========================================================
           FEATURED QUOTE
        ========================================================= */

        .featured-voice {
            margin: 0 0 70px;

            padding: 45px;

            border-radius: 20px;

            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    var(--primary-dark)
                );

            color: #fff;

            text-align: center;
        }

        .featured-voice .quote-mark {
            margin-bottom: 10px;

            font-family: Georgia, serif;

            font-size: 4rem;
            line-height: 0.7;

            opacity: 0.35;
        }

        .featured-voice blockquote {
            max-width: 800px;

            margin: 0 auto 20px;

            color: #fff;

            font-family: Georgia, serif;

            font-size: clamp(1.3rem, 3vw, 2rem);
            line-height: 1.45;
        }

        .featured-voice cite {
            color: rgba(255,255,255,0.7);

            font-size: 0.75rem;
            font-style: normal;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }


        /* =========================================================
           CTA
        ========================================================= */

        .alumni-cta {
            padding: 70px 0;

            background: var(--dark);
        }

        .alumni-cta-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 30px;
        }

        .alumni-cta h2 {
            margin: 0 0 8px;

            color: #fff;

            font-size: clamp(1.7rem, 4vw, 2.6rem);
            line-height: 1.1;
        }

        .alumni-cta p {
            max-width: 620px;

            margin: 0;

            color: #aaa;

            font-size: 0.9rem;
        }

        .alumni-cta-button {
            flex-shrink: 0;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            min-height: 46px;

            padding: 0 27px;

            background: var(--primary);

            color: #fff;

            font-size: 0.75rem;
            font-weight: 800;

            clip-path:
                polygon(
                    10% 0,
                    100% 0,
                    90% 100%,
                    0 100%
                );

            transition:
                background 0.2s ease,
                transform 0.2s ease;
        }

        .alumni-cta-button:hover {
            background: #8b0870;
            transform: translateY(-2px);
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media (max-width: 950px) {

            .alumni-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .year-heading {
                align-items: flex-start;
                flex-direction: column;
            }

            .alumni-cta-inner {
                align-items: flex-start;
                flex-direction: column;
            }
        }


        @media (max-width: 650px) {

            .container {
                width: min(100% - 28px, 1180px);
            }

            .alumni-hero {
                min-height: 380px;
            }

            .hero-content {
                padding: 55px 0;
            }

            .year-nav-inner {
                justify-content: flex-start;

                overflow-x: auto;

                padding: 10px 0;
            }

            .year-nav-inner a {
                flex-shrink: 0;
            }

            .alumni-intro {
                padding: 55px 0 35px;
            }

            .year-section {
                padding: 45px 0;
            }

            .alumni-grid {
                grid-template-columns: 1fr;
            }

            .alumni-photo {
                height: 300px;
            }

            .featured-voice {
                padding: 30px 20px;
                margin-bottom: 45px;
            }

            .alumni-cta {
                padding: 50px 0;
            }
        }
    </style>
</head>


