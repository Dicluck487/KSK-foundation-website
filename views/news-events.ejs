<section class="page-header">
  <div class="container">
    <h1>News &amp; Events</h1>
    <p>Latest news, stories, and events from the mentorship program.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="news-grid">
      <% newsEvents.forEach(function(item) { %>
        <article class="news-card">
          <img src="/images/2image5.jpg" alt="<%= item.title %>">
          <div class="news-card-body">
            <span class="news-date"><%= item.date %></span>
            <h3><%= item.title %></h3>
            <p><%= item.excerpt %></p>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<style>
  .page-header {
  position: relative;
  overflow: hidden;
  background-image:
    linear-gradient(135deg, rgba(37, 1, 44, 0.78), rgba(235, 109, 247, 0.55)),
    url('/images/n&e1.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
.page-header .section-eyebrow { color: rgba(255,255,255,0.85); }
.page-header h1 { color: #eba852; }
 .page-header p { color: #fff; }
</style>
