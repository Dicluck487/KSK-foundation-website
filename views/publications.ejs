


<!-- =========================================================
     PUBLICATIONS INTRO
========================================================= -->

<section class="section publications-intro">

  <div class="container">

    <div class="publications-intro-grid">

      <div>

        <span class="section-eyebrow">
          OUR PUBLICATIONS
        </span>

        <h2>
          Stories, Insights &amp; Impact
        </h2>

      </div>

      <div>

        <p>
          Our publications document the experiences, achievements and
          opportunities created through KSK Foundation's programs.
        </p>

        <p>
          From participant stories and program insights to annual
          highlights, these publications provide a window into the
          Foundation's work and its growing community.
        </p>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     FOCUS MAGAZINE
========================================================= -->

<section class="section focus-magazine">

  <div class="container">

   
    <!-- CURRENT ISSUE -->

    <div class="current-publication" id="section1">

      <div class="publication-cover">

        <!-- Replace this image with the actual current FOCUS cover -->
        <img
          src="/documents/focus-magazine-current-cover.jpg"
          alt="FOCUS Magazine current issue"
          onerror="this.src='/images/2image3.jpeg'"
        
        />

        <span class="current-badge">
          CURRENT ISSUE
        </span>

      </div>


      <div class="publication-details">

        <span class="publication-label">
          FOCUS MAGAZINE
        </span>

        <h3>
          FOCUS Magazine
        </h3>

        <p class="publication-description">
          Discover stories from KSK Foundation's programs, hear from
          participants and alumni, and explore the people and ideas
          helping young Ugandans become leaders, innovators and
          entrepreneurs.
        </p>

        <div class="publication-meta">

          <div>
            <span>Publication</span>
            <strong>FOCUS Magazine</strong>
          </div>

          <div>
            <span>Status</span>
            <strong>Current Issue</strong>
          </div>

        </div>


        <div class="publication-actions">

          <!--
            Reads the current issue in place, the same way the
            FOCUS Magazine 2025 / 2026 Prospectus pages on
            thementorshipclass.com do: the PDF opens inline for
            reading, with a "download in case of delayed loading"
            fallback until the reader is closed.

            data-reader-pdf   -> path to the PDF to embed
            data-reader-title -> title shown above the reader
          -->
          <a
            href="/documents/focus-magazine-current.pdf"
            class="btn btn-primary"
            data-reader-pdf="/documents/focus-magazine-current.pdf"
            data-reader-title="FOCUS Magazine — Current Issue"
            onclick="return openPublicationReader(event, this);"
          >
            Read Current Issue
          </a>

          <a
            href="#focus-archive"
            class="btn btn-outline"
          >
            View Archive
          </a>

        </div>

      </div>

    </div>

  </div>

</section>



