<!-- =========================================================
     PAGE JS — inline publication reader (page-flip)

     Uses PDF.js to rasterize each page of the PDF in the browser,
     then PageFlip to give it a realistic page-turn effect — the
     same flipbook experience as the magazine pages on
     thementorshipclass.com. If either library fails to load, or
     rendering throws, it falls back automatically to a plain
     embedded PDF with a download link.

     Swap the CDN URLs below for self-hosted copies (e.g. installed
     via npm and served from /public/vendor/) whenever you'd rather
     not depend on a third-party CDN in production.
========================================================= -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://unpkg.com/page-flip@2.0.7/dist/js/page-flip.browser.js"></script>

<script>

  (function () {

    var flipInstance = null;
    var renderToken = 0; // guards against a stale render finishing after a newer one starts

    // -------- flip sound --------
    // Synthesized in-browser (short filtered noise burst that
    // sweeps down in pitch) so there's no extra audio file to
    // host — plays on every page turn, however it was triggered
    // (buttons, swipe, or arrow keys).
    var flipAudioCtx = null;

    function playFlipSound() {
      try {
        if (!flipAudioCtx) {
          var Ctx = window.AudioContext || window.webkitAudioContext;
          if (!Ctx) return;
          flipAudioCtx = new Ctx();
        }
        if (flipAudioCtx.state === 'suspended') flipAudioCtx.resume();

        var ctx = flipAudioCtx;
        var now = ctx.currentTime;
        var duration = 0.26;

        var bufferSize = Math.round(ctx.sampleRate * duration);
        var buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        var data = buffer.getChannelData(0);
        for (var i = 0; i < bufferSize; i++) {
          // white noise, tapered off toward the end for a "swish"
          data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / bufferSize, 2);
        }

        var noise = ctx.createBufferSource();
        noise.buffer = buffer;

        var filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.Q.value = 0.8;
        filter.frequency.setValueAtTime(2400, now);
        filter.frequency.exponentialRampToValueAtTime(500, now + duration);

        var gain = ctx.createGain();
        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(0.3, now + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);

        noise.start(now);
        noise.stop(now + duration);
      } catch (e) {
        // Audio is a nice-to-have — never let it break page flipping.
      }
    }

    function setPdfWorker() {
      if (window.pdfjsLib) {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc =
          'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }
    }

    function useFallbackViewer(pdf) {

      var body = document.querySelector('.publication-reader-body');
      var frame = document.getElementById('publication-reader-frame');

      body.classList.add('is-fallback');
      frame.src = pdf;

      document.getElementById('publication-flip-loading').classList.remove('is-visible');

    }

    function updatePageIndicator(current, total) {

      var indicator = document.getElementById('publication-flip-pageindicator');
      var prevBtn = document.getElementById('publication-flip-prev');
      var nextBtn = document.getElementById('publication-flip-next');

      indicator.textContent = 'Page ' + current + ' / ' + total;
      prevBtn.disabled = current <= 1;
      nextBtn.disabled = current >= total;

    }

    async function renderFlipbook(pdf) {

      var myToken = ++renderToken;

      var container = document.getElementById('publication-flipbook');
      var loading = document.getElementById('publication-flip-loading');
      var body = document.querySelector('.publication-reader-body');

      body.classList.remove('is-fallback');
      container.innerHTML = '';
      loading.classList.add('is-visible');

      // Keep the nav buttons inert until there's an actual book to
      // flip, so an early click can't silently do nothing.
      document.getElementById('publication-flip-prev').disabled = true;
      document.getElementById('publication-flip-next').disabled = true;
      document.getElementById('publication-flip-pageindicator').textContent = '';

      if (!window.pdfjsLib || !window.St || !window.St.PageFlip) {
        useFallbackViewer(pdf);
        return;
      }

      try {

        setPdfWorker();

        var doc = await window.pdfjsLib.getDocument(pdf).promise;
        var maxW = 0, maxH = 0;

        for (var i = 1; i <= doc.numPages; i++) {

          if (myToken !== renderToken) return; // a newer reader was opened

          var page = await doc.getPage(i);
          // Render at a high base resolution (and match device
          // pixel ratio, capped so huge desktop monitors don't
          // over-render) so pages stay sharp when the flipbook is
          // stretched to fill a large panel or fullscreen.
          var renderScale = 2.2 * Math.min(window.devicePixelRatio || 1, 2);
          var viewport = page.getViewport({ scale: renderScale });

          var canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;

          await page.render({
            canvasContext: canvas.getContext('2d'),
            viewport: viewport
          }).promise;

          var pageEl = document.createElement('div');
          pageEl.className = 'page';
          pageEl.appendChild(canvas);
          container.appendChild(pageEl);

          maxW = Math.max(maxW, viewport.width);
          maxH = Math.max(maxH, viewport.height);

        }

        if (myToken !== renderToken) return;

        if (flipInstance) {
          try { flipInstance.destroy(); } catch (e) {}
          flipInstance = null;
        }

        flipInstance = new window.St.PageFlip(container, {
          width: Math.round(maxW) || 400,
          height: maxH || 560,
          size: 'stretch',
          // Let the flipbook grow to fill most of the (now larger)
          // reader panel, and further still in true fullscreen —
          // 'stretch' scales pages up to these bounds while
          // keeping their aspect ratio. width/height above must
          // match a SINGLE page's real aspect ratio (not half of
          // it) — PageFlip lays two of these side by side itself
          // for the two-page spread, so halving the width here
          // squeezes every page into a box twice as tall as it
          // should be, which is what was making documents look
          // narrow and hard to read.
          minWidth: 320,
          maxWidth: 950,
          minHeight: 450,
          maxHeight: 2400,
          // false so page 1 opens as part of a normal two-page
          // spread like every other page, instead of being
          // treated as a standalone "cover" that flips alone.
          showCover: false,
          usePortrait: true,
          maxShadowOpacity: 0.5,
          mobileScrollSupport: true
        });

        flipInstance.loadFromHTML(container.querySelectorAll('.page'));

        var total = flipInstance.getPageCount();
        updatePageIndicator(flipInstance.getCurrentPageIndex() + 1, total);

        flipInstance.on('flip', function (e) {
          updatePageIndicator(e.data + 1, total);
          playFlipSound();
        });

        loading.classList.remove('is-visible');

        // 'stretch' mode measures its container on init, but the
        // panel can still be settling into its final layout at
        // that exact moment (fonts/backdrop transition etc.), so
        // the book can end up sized/centered against a stale
        // measurement. A resize nudge one tick later re-centers
        // it without waiting for the user to hit fullscreen.
        setTimeout(function () {
          window.dispatchEvent(new Event('resize'));
        }, 50);

      } catch (err) {

        if (myToken !== renderToken) return;
        useFallbackViewer(pdf);

      }

    }

    window.openPublicationReader = function (event, el) {

      if (event) event.preventDefault();

      var pdf = el.getAttribute('data-reader-pdf');
      if (!pdf) return false;

      var title = el.getAttribute('data-reader-title') || 'Reading';

      var modal = document.getElementById('publication-reader');
      var titleEl = document.getElementById('publication-reader-title');
      var downloadBtn = document.getElementById('publication-reader-download');
      var fallbackLink = document.getElementById('publication-reader-fallback-link');

      titleEl.textContent = title;
      downloadBtn.href = pdf;
      fallbackLink.href = pdf;

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('publication-reader-open');

      renderFlipbook(pdf);

      return false;

    };

    window.closePublicationReader = function () {

      renderToken++; // invalidate any render still in flight

      if (document.fullscreenElement || document.webkitFullscreenElement) {
        if (document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
      }

      var modal = document.getElementById('publication-reader');
      var frame = document.getElementById('publication-reader-frame');
      var body = document.querySelector('.publication-reader-body');

      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('publication-reader-open');

      frame.src = '';
      body.classList.remove('is-fallback');

      if (flipInstance) {
        try { flipInstance.destroy(); } catch (e) {}
        flipInstance = null;
      }

    };

    window.togglePublicationFullscreen = function () {

      var panel = document.querySelector('.publication-reader-panel');
      var isFullscreen = document.fullscreenElement || document.webkitFullscreenElement;

      if (!isFullscreen) {
        if (panel.requestFullscreen) panel.requestFullscreen();
        else if (panel.webkitRequestFullscreen) panel.webkitRequestFullscreen();
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
      }

    };

    function onFullscreenChange() {

      var btn = document.getElementById('publication-reader-fullscreen');
      var isFullscreen = document.fullscreenElement || document.webkitFullscreenElement;

      if (btn) btn.classList.toggle('is-active', !!isFullscreen);

      // 'stretch' mode re-measures its container on window resize;
      // fullscreen doesn't always fire one reliably in every
      // browser, so nudge it manually.
      window.dispatchEvent(new Event('resize'));

    }

    document.addEventListener('fullscreenchange', onFullscreenChange);
    document.addEventListener('webkitfullscreenchange', onFullscreenChange);

    document.getElementById('publication-flip-prev').addEventListener('click', function () {
      if (flipInstance) flipInstance.flipPrev('bottom');
    });

    document.getElementById('publication-flip-next').addEventListener('click', function () {
      if (flipInstance) flipInstance.flipNext('bottom');
    });

    document.addEventListener('keydown', function (e) {

      var modal = document.getElementById('publication-reader');
      if (!modal || !modal.classList.contains('is-open')) return;

      if (e.key === 'Escape') {
        // If in fullscreen, let the browser's own Escape handling
        // exit fullscreen first rather than also closing the
        // reader in the same keystroke.
        if (!(document.fullscreenElement || document.webkitFullscreenElement)) {
          window.closePublicationReader();
        }
      } else if (e.key === 'ArrowRight' && flipInstance) {
        flipInstance.flipNext('bottom');
      } else if (e.key === 'ArrowLeft' && flipInstance) {
        flipInstance.flipPrev('bottom');
      }

    });

    // Delegated handler: any future link/button anywhere on the
    // page with a data-reader-pdf attribute automatically opens in
    // the same reader — no extra wiring needed as more issues,
    // prospectuses or year-in-review documents are added.
    document.addEventListener('click', function (e) {

      var trigger = e.target.closest('[data-reader-pdf]');
      if (!trigger) return;

      // Already handled directly via onclick for elements that set
      // it inline; this covers ones added later without an onclick.
      if (trigger.hasAttribute('onclick')) return;

      window.openPublicationReader(e, trigger);

    });

  })();

</script>