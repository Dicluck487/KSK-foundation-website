          here unless specifically approved by the Foundation.
        </p>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     PROSPECTUSES & OTHER PUBLICATIONS
========================================================= -->

<section class="section other-publications">

  <div class="container">

    <div class="section-heading">

      <span class="section-eyebrow">
        OTHER PUBLICATIONS
      </span>

      <h2>
        Prospectuses &amp; Program Documents
      </h2>

      <p>
        Explore prospectuses and other public documents that provide
        more information about KSK Foundation's programs.
      </p>

    </div>


    <div class="publications-grid">

      <% if (publications && publications.length) { %>

        <% publications.forEach(function(p) { %>

          <a
            href="/publications/<%= p.slug %>"
            class="publication-card"
          >

            <div class="publication-card-image">

              <img
                src="<%= p.image || '/images/2image3.jpeg' %>"
                alt="<%= p.title %>"
                onerror="this.src='/images/2image3.jpeg'"
              />

            </div>

            <div class="publication-card-content">

              <span class="publication-card-type">
                PUBLICATION
              </span>

              <h3>
                <%= p.title %>
              </h3>

              <p>
                <%= p.description %>
              </p>

              <span class="publication-read">
                Read Publication →
              </span>

            </div>

          </a>

        <% }); %>

      <% } else { %>

        <div class="archive-empty">

          <div class="archive-empty-icon">
            +
          </div>

          <h3>
            Publications Coming Soon
          </h3>

          <p>
            Prospectuses and additional public-facing publications
            will be added here as they become available.
          </p>

        </div>

      <% } %>

    </div>

  </div>

</section>


