     ANNUAL REPORT NOTICE
========================================================= -->

<section class="section report-notice">

  <div class="container">

    <div class="report-notice-card">

      <div class="report-notice-icon">
        !
      </div>

      <div>

        <span class="section-eyebrow">
          PUBLICATION NOTE
        </span>

        <h3>
          About KSK Foundation's Annual Reports
        </h3>

        <p>
          The Publications page is intended for public-facing
          Year in Review summaries and approved highlights rather
          than the Foundation's internal Annual Reports.
        </p>

