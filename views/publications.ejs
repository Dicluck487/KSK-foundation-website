<!-- =========================================================
     INLINE PUBLICATION READER
     Opens over the page when a "Read"/"Coming Soon"-turned-live
     link has a data-reader-pdf attribute (see the Current Issue
     button above). Matches the read-inline-then-download pattern
     used on thementorshipclass.com's publication pages.
========================================================= -->

<div
  class="publication-reader"
  id="publication-reader"
  aria-hidden="true"
>

  <div
    class="publication-reader-backdrop"
    onclick="closePublicationReader();"
  ></div>

  <div
    class="publication-reader-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="publication-reader-title"
  >

    <div class="publication-reader-bar">

      <span
        class="publication-reader-title"
        id="publication-reader-title"
      >
        Reading
      </span>

      <div class="publication-reader-bar-actions">

        <a
          class="btn btn-outline btn-sm"
          id="publication-reader-download"
          href="#"
          download
        >
          Download
        </a>

        <button
          type="button"
          class="publication-reader-icon-btn"
          id="publication-reader-fullscreen"
          aria-label="View full page"
          title="View full page"
          onclick="window.togglePublicationFullscreen();"
        >
          &#x26F6;
        </button>

        <button
          type="button"
          class="publication-reader-close"
          aria-label="Close reader"
          onclick="closePublicationReader();"
        >
          &times;
        </button>

      </div>

    </div>

    <div class="publication-reader-body">

      <!-- Realistic page-turn flipbook, rendered client-side from
           the PDF via PDF.js + PageFlip — same reading experience
           as the flipbook viewer on thementorshipclass.com. Falls
           back automatically to a plain embedded PDF if either
           library fails to load. -->
      <div class="publication-flipbook-wrap" id="publication-flipbook-wrap">

        <div class="publication-flipbook" id="publication-flipbook"></div>

        <div class="publication-flip-controls" id="publication-flip-controls">

          <button
            type="button"
            id="publication-flip-prev"
            aria-label="Previous page"
          >
            &lsaquo;
          </button>

          <span id="publication-flip-pageindicator">
            &nbsp;
          </span>

          <button
            type="button"
            id="publication-flip-next"
            aria-label="Next page"
          >
            &rsaquo;
          </button>

        </div>

        <div class="publication-flip-loading" id="publication-flip-loading">
          <span>Loading pages&hellip;</span>
        </div>

      </div>

      <!-- Plain fallback viewer — hidden unless the flipbook
           can't initialize. -->
      <iframe
        id="publication-reader-frame"
        title="Publication reader"
        class="publication-reader-frame-fallback"
        src=""
      ></iframe>

      <p class="publication-reader-fallback">
        Taking a while to load?
        <a id="publication-reader-fallback-link" href="#" download>
          Download the document instead
        </a>.
      </p>

    </div>

  </div>

</div>


<!-- =========================================================
     PAGE CSS
========================================================= -->

<style>

  /* =========================================================
     HEADER
  ========================================================= */

  .publications-header {
    position: relative;
    overflow: hidden;
  }

  .publications-header .section-eyebrow {
    color: rgba(255,255,255,0.8);
  }


  /* =========================================================
     INTRO
  ========================================================= */

  .publications-intro-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 80px;
    align-items: center;
  }

  .publications-intro-grid h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.1;
  }

  .publications-intro-grid p {
    margin: 0 0 15px;
    color: var(--color-muted, #6b7280);
    line-height: 1.8;
  }


  /* =========================================================
     SECTION HEADINGS
  ========================================================= */

  .section-heading {
    max-width: 760px;
    margin-bottom: 45px;
  }

  .section-heading h2 {
    margin: 0 0 15px;
  }

  .section-heading p {
    margin: 0;
    color: var(--color-muted, #6b7280);
    line-height: 1.8;
  }

  .section-eyebrow {
    display: inline-block;
    margin-bottom: 12px;
    color: var(--color-primary, #e0392c);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }


  /* =========================================================
     FOCUS MAGAZINE
  ========================================================= */

  .focus-magazine {
    background: var(--color-bg-alt, #f6f5f3);
  }

  .current-publication {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 70px;
    align-items: center;
  }

  .publication-cover {
    position: relative;
  }

  .publication-cover img {
    display: block;
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 25px 60px rgba(0,0,0,0.15);
  }

  .current-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    padding: 8px 13px;
    border-radius: 30px;
    background: var(--color-primary, #e0392c);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .publication-label {
    color: var(--color-primary, #e0392c);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .publication-details h3 {
    margin: 10px 0 18px;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .publication-description {
    max-width: 650px;
    color: var(--color-muted, #6b7280);
    line-height: 1.8;
    font-size: 1rem;
  }

  .publication-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 35px;
    margin: 28px 0;
  }

  .publication-meta div {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .publication-meta span {
    color: var(--color-muted, #6b7280);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .publication-meta strong {
    font-size: 0.9rem;
  }

  .publication-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }


  /* =========================================================
     ARCHIVE
  ========================================================= */

  .publication-archive {
    background: #fff;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .archive-empty {
    grid-column: 1 / -1;
    padding: 60px 30px;
    text-align: center;
    border: 1px dashed rgba(0,0,0,0.15);
    border-radius: 18px;
    background: var(--color-bg-alt, #f6f5f3);
  }

  .archive-empty-icon {
    width: 55px;
    height: 55px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: rgba(224,57,44,0.1);
    color: var(--color-primary, #e0392c);
    font-size: 1.6rem;
    font-weight: 700;
  }

  .archive-empty h3 {
    margin: 0 0 10px;
  }

  .archive-empty p {
    max-width: 520px;
    margin: auto;
    color: var(--color-muted, #6b7280);
    line-height: 1.7;
  }


  /* =========================================================
     ANNUAL HIGHLIGHTS
  ========================================================= */

  .annual-highlights {
    background: var(--color-bg-alt, #f6f5f3);
  }

  .annual-highlights-intro {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 30px;
    padding: 40px;
    margin-bottom: 50px;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .annual-icon {
    width: 75px;
    height: 75px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: var(--color-primary, #e0392c);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 900;
  }

  .annual-highlights-intro h3 {
    margin: 0 0 15px;
    font-size: 1.5rem;
  }

  .annual-highlights-intro p {
    margin: 0 0 12px;
    color: var(--color-muted, #6b7280);
    line-height: 1.8;
  }


  /* =========================================================
     YEAR ARCHIVE
  ========================================================= */

  .year-review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
  }

  .year-review-header h3 {
