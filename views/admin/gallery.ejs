<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Gallery — KSK Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <%- include('partials/sidebar', { active: 'gallery' }) %>
  <main class="admin-main">
    <div class="admin-topbar"><h1>Gallery</h1></div>

    <% if (currentAdmin.role !== 'viewer') { %>
    <div class="panel">
      <h2>Upload photo</h2>
      <form method="POST" action="/admin/gallery/upload" enctype="multipart/form-data" class="form-grid">
        <div><label>Photo</label><input type="file" name="photo" accept="image/*" required></div>
        <div><label>Title</label><input type="text" name="title"></div>
        <div><label>Category</label>
          <select name="category">
            <option>MSWRP</option>
            <option>Kaizen Teen Boot Camp</option>
            <option>Financial Services Academy</option>
            <option>Graduation & Events</option>
            <option>Community & Scholarships</option>
          </select>
        </div>
        <div><label>Year</label><input type="number" name="year" placeholder="2026"></div>
        <div><label>Alt text</label><input type="text" name="alt_text"></div>
        <button type="submit" class="btn primary">Upload</button>
      </form>
    </div>
    <% } %>

    <div class="panel">
      <h2>All photos</h2>
      <% if (photos.length === 0) { %>
        <div class="empty-state">No photos uploaded yet.</div>
      <% } else { %>
        <table class="admin-table">
          <thead><tr><th></th><th>Title</th><th>Category</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% photos.forEach(p => { %>
              <tr>
                <td><img class="thumb" src="<%= p.url %>" alt="<%= p.alt_text || '' %>"></td>
                <td><%= p.title || '—' %></td>
                <td><%= p.category || '—' %></td>
                <td><span class="badge <%= p.status %>"><%= p.status %></span></td>
                <td>
                  <% if (currentAdmin.role !== 'viewer') { %>
                    <form method="POST" action="/admin/gallery/<%= p.id %>/status" style="display:inline;">
                      <input type="hidden" name="status" value="<%= p.status === 'published' ? 'draft' : 'published' %>">
                      <button type="submit" class="btn small"><%= p.status === 'published' ? 'Unpublish' : 'Publish' %></button>
                    </form>
                    <form method="POST" action="/admin/gallery/<%= p.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this photo?');">
                      <button type="submit" class="btn small danger">Delete</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
