<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Subscribers — KSK Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <%- include('partials/sidebar', { active: 'subscribers' }) %>
  <main class="admin-main">
    <div class="admin-topbar">
      <h1>Newsletter Subscribers</h1>
      <a href="/admin/export/subscribers" class="btn">Download CSV</a>
    </div>
    <div class="panel">
      <% if (subscribers.length === 0) { %>
        <div class="empty-state">No subscribers yet.</div>
      <% } else { %>
        <table class="admin-table">
          <thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Subscribed</th></tr></thead>
          <tbody>
            <% subscribers.forEach(s => { %>
              <tr>
                <td><%= s.name || '—' %></td>
                <td><%= s.email %></td>
                <td><span class="badge <%= s.status %>"><%= s.status %></span></td>
                <td><%= new Date(s.subscribed_at).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
