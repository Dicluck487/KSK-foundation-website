<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Hero Images — KSK Foundation</title>

  <link rel="stylesheet" href="/css/admin.css">

  <style>
    .hero-page {
      padding: 30px;
    }

    .hero-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 30px;
    }

    .hero-header h1 {
      margin: 0;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 25px;
    }

    .hero-card {
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    }

    .hero-image {
      width: 100%;
      height: 190px;
      object-fit: cover;
      display: block;
    }

    .hero-content {
      padding: 18px;
    }

    .hero-content h3 {
      margin-top: 0;
      margin-bottom: 8px;
    }

    .hero-meta {
      font-size: 14px;
      color: #666;
      margin-bottom: 6px;
    }

    .hero-actions {
      display: flex;
      gap: 10px;
      margin-top: 18px;
      flex-wrap: wrap;
    }

    .hero-actions form {
      margin: 0;
    }

    .hero-actions button {
      border: 0;
      border-radius: 6px;
      padding: 9px 14px;
      cursor: pointer;
    }

    .btn-publish {
      background: #198754;
      color: white;
    }

    .btn-draft {
      background: #6c757d;
      color: white;
    }

    .btn-delete {
      background: #dc3545;
      color: white;
    }

    .empty-state {
      padding: 50px;
      background: #fff;
      border-radius: 12px;
      text-align: center;
      color: #666;
    }

    .add-form {
      background: #fff;
      padding: 25px;
      border-radius: 12px;
      margin-bottom: 30px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    .form-group input,
    .form-group select {
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 6px;
    }

    .btn-add {
      margin-top: 18px;
      background: #0d6efd;
      color: white;
      border: 0;
      padding: 11px 18px;
      border-radius: 6px;
      cursor: pointer;
    }

    @media (max-width: 700px) {
      .hero-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .form-group.full {
        grid-column: auto;
      }

      .hero-page {
        padding: 15px;
      }
    }
  </style>
</head>

<body>

<div class="hero-page">

  <div class="hero-header">
    <div>
      <h1>Hero Images</h1>
      <p>Manage the images displayed in the website hero section.</p>
    </div>

    <a href="/admin/dashboard">
      ← Back to Dashboard
    </a>
  </div>


  <!-- ADD HERO RECORD -->

  <div class="add-form">

    <h2>Add Hero Image</h2>

    <p>
      First upload the image to the
      <strong>hero-images</strong>
      Supabase Storage bucket.
      Then enter its Storage path below.
    </p>

    <form action="/admin/hero-images" method="POST">

      <div class="form-grid">

        <div class="form-group">
          <label for="title">Title</label>

          <input
            type="text"
            id="title"
            name="title"
            placeholder="Hero Image 1"
          >
        </div>


        <div class="form-group">
          <label for="storage_path">Storage Path *</label>

          <input
            type="text"
            id="storage_path"
            name="storage_path"
            placeholder="hero1.jpg"
            required
          >
        </div>


        <div class="form-group full">
          <label for="alt_text">Alt Text</label>

          <input
            type="text"
            id="alt_text"
            name="alt_text"
            placeholder="KSK Foundation participants"
          >
        </div>


        <div class="form-group">
          <label for="display_order">Display Order</label>

          <input
            type="number"
            id="display_order"
            name="display_order"
            value="1"
            min="0"
          >
        </div>


        <div class="form-group">
          <label for="status">Status</label>

          <select id="status" name="status">
            <option value="published">Published</option>
            <option value="draft">Draft</option>
          </select>
        </div>

      </div>

      <button type="submit" class="btn-add">
        Add Hero Image
      </button>

    </form>

  </div>


  <!-- HERO IMAGE LIST -->

  <% if (!heroImages || heroImages.length === 0) { %>

    <div class="empty-state">

      <h2>No Hero Images</h2>

      <p>
        Upload an image to Supabase Storage and create your first Hero record.
      </p>

    </div>

  <% } else { %>

    <div class="hero-grid">

      <% heroImages.forEach(function(image) { %>

        <div class="hero-card">

          <img
            src="<%= image.public_url %>"
            alt="<%= image.alt_text || image.title || 'Hero image' %>"
            class="hero-image"
          >

          <div class="hero-content">

            <h3>
              <%= image.title || 'Untitled Hero Image' %>
            </h3>

            <div class="hero-meta">
              Storage: <%= image.storage_path %>
            </div>

            <div class="hero-meta">
              Order: <%= image.display_order %>
            </div>

            <div class="hero-meta">
              Status: <strong><%= image.status %></strong>
            </div>


            <div class="hero-actions">

              <% if (image.status !== 'published') { %>

                <form
                  action="/admin/hero-images/<%= image.id %>/status"
                  method="POST"
                >

                  <input
                    type="hidden"
                    name="status"
                    value="published"
                  >

                  <button
                    type="submit"
                    class="btn-publish"
                  >
                    Publish
                  </button>

                </form>

              <% } %>


              <% if (image.status === 'published') { %>

                <form
                  action="/admin/hero-images/<%= image.id %>/status"
                  method="POST"
                >

                  <input
                    type="hidden"
                    name="status"
                    value="draft"
                  >

                  <button
                    type="submit"
                    class="btn-draft"
                  >
                    Set Draft
                  </button>

                </form>

              <% } %>


              <form
                action="/admin/hero-images/<%= image.id %>/delete"
                method="POST"
                onsubmit="return confirm('Delete this Hero record?');"
              >

                <button
                  type="submit"
                  class="btn-delete"
                >
                  Delete
                </button>

              </form>

            </div>

          </div>

        </div>

      <% }); %>

    </div>

  <% } %>

</div>

</body>
</html>