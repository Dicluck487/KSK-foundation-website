<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Users — KSK Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-shell">
  <%- include('partials/sidebar', { active: 'admins' }) %>
  <main class="admin-main">
    <div class="admin-topbar"><h1>Admin Users</h1></div>
    <div class="panel">
      <table class="admin-table">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Since</th><th></th></tr></thead>
        <tbody>
          <% admins.forEach(u => { %>
            <tr>
              <td><%= u.name %><% if (u.id === currentUserId) { %> <small style="color:#6b7280;">(you)</small><% } %></td>
              <td><%= u.email %></td>
              <td>
                <% if (u.id === currentUserId) { %>
                  <span class="badge <%= u.role %>"><%= u.role.replace('_',' ') %></span>
                <% } else { %>
                  <form method="POST" action="/admin/admins/<%= u.id %>/role" style="display:inline-flex;gap:6px;">
                    <select name="role" class="btn small" style="padding:5px 8px;">
                      <option value="super_admin" <%= u.role==='super_admin'?'selected':'' %>>Super Admin</option>
                      <option value="content_admin" <%= u.role==='content_admin'?'selected':'' %>>Content Admin</option>
                      <option value="viewer" <%= u.role==='viewer'?'selected':'' %>>Viewer</option>
                    </select>
                    <button type="submit" class="btn small">Update</button>
                  </form>
                <% } %>
              </td>
              <td><span class="badge <%= u.status %>"><%= u.status %></span></td>
              <td><%= new Date(u.created_at).toLocaleDateString() %></td>
              <td>
                <% if (u.id !== currentUserId) { %>
                  <% if (u.status === 'active') { %>
                    <form method="POST" action="/admin/admins/<%= u.id %>/status" style="display:inline;">
                      <input type="hidden" name="status" value="suspended">
                      <button type="submit" class="btn small danger">Suspend</button>
                    </form>
                  <% } else if (u.status === 'suspended') { %>
                    <form method="POST" action="/admin/admins/<%= u.id %>/status" style="display:inline;">
                      <input type="hidden" name="status" value="active">
                      <button type="submit" class="btn small primary">Reactivate</button>
                    </form>
                  <% } %>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</div>
</body>
</html>
