<!--
  views/partials/recent-gallery.ejs
  Include on the homepage from index.ejs using EJS include syntax, passing recentPhotos.
  Expects `recentPhotos` — array of up to 3 items: { id, title, category, url, alt_text }
-->

<% if (typeof recentPhotos !== 'undefined' && recentPhotos.length > 0) { %>
<section class="ksk-recent-gallery">
  <div class="ksk-recent-gallery-wrap">
    <div class="ksk-recent-gallery-heading">
      <p class="ksk-recent-eyebrow">From the field</p>
      <h2>Recent Moments</h2>
    </div>

    <div class="ksk-recent-grid">
      <% recentPhotos.forEach(photo => { %>
        <a href="/gallery" class="ksk-recent-item" aria-label="View full gallery">
          <img
            src="<%= photo.url %>"
            alt="<%= photo.alt_text || photo.title || 'KSK Foundation photo' %>"
            loading="lazy"
          >
          <% if (photo.title || photo.category) { %>
            <span class="ksk-recent-caption">
              <%= photo.title || photo.category %>
            </span>
          <% } %>
        </a>
      <% }) %>
    </div>

    <div class="ksk-recent-cta">
      <a href="/gallery" class="ksk-recent-btn">View Full Gallery →</a>
    </div>
  </div>
</section>

<style>
  .ksk-recent-gallery { padding: 64px 24px; background: #fff; }
  .ksk-recent-gallery-wrap { max-width: 1100px; margin: 0 auto; }

  .ksk-recent-gallery-heading { text-align: center; margin-bottom: 32px; }
  .ksk-recent-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 12px;
    font-weight: 700;
    color: #b23fd6;
    margin: 0 0 8px;
  }
  .ksk-recent-gallery-heading h2 {
    font-size: clamp(26px, 4vw, 34px);
    margin: 0;
    color: #201233;
    font-weight: 800;
  }

  .ksk-recent-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .ksk-recent-item {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(20, 10, 40, 0.08);
  }
  .ksk-recent-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .ksk-recent-item:hover img { transform: scale(1.07); }

  .ksk-recent-caption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 14px 14px 12px;
    background: linear-gradient(to top, rgba(15,8,28,0.75), transparent);
    color: #fff;
    font-size: 13.5px;
    font-weight: 600;
  }

  .ksk-recent-cta { text-align: center; margin-top: 30px; }
  .ksk-recent-btn {
    display: inline-block;
    background: #6a2fb8;
    color: #fff;
    padding: 12px 26px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .ksk-recent-btn:hover { background: #59258f; }

  @media (max-width: 640px) {
    .ksk-recent-grid { grid-template-columns: 1fr; gap: 14px; }
    .ksk-recent-gallery { padding: 48px 18px; }
  }
</style>
<% } %>
