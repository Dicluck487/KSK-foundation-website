<section class="page-header">
  <div class="container">
    <h1>Apply Today</h1>
    <p>Take the first step toward your mentorship journey.</p>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <% if (submitted) { %>
      <div class="alert alert-success">Your application has been received. We'll be in touch soon!</div>
    <% } else { %>
      <form method="POST" action="/apply" class="site-form">
        <label>
          Full Name
          <input type="text" name="name" required>
        </label>
        <label>
          Email
          <input type="email" name="email" required>
        </label>
        <label>
          Phone Number
          <input type="tel" name="phone" required>
        </label>
        <label>
          Why do you want to join this program?
          <textarea name="motivation" rows="6" required></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Submit Application</button>
      </form>
    <% } %>
  </div>
</section>
