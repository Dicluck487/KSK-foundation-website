<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Publications — KSK Foundation
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/publications.css"
    >
</head>


<body>

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <%- include('partials/header') %>


    <!-- =====================================================
         PAGE HERO
    ====================================================== -->

    <section class="publication-hero">

        <div class="container">

            <span class="section-eyebrow">
                KSK FOUNDATION
            </span>

            <h1>
                Publications
            </h1>

            <p>
                Explore our magazines, reports and publications
                documenting the work, stories and impact of
                KSK Foundation.
            </p>

        </div>

    </section>



    <!-- =====================================================
         CURRENT ISSUE
    ====================================================== -->

    <section
        class="section current-publication"
        id="current-issue"
    >

        <div class="container">

            <div class="section-heading">

                <span class="section-eyebrow">
                    CURRENT ISSUE
                </span>

                <h2>
                    Latest Publication
                </h2>

                <p>
                    Read the latest publication from
                    KSK Foundation.
                </p>

            </div>


            <% if (currentPublication) { %>

                <div class="current-publication-card">


                    <!-- COVER -->
                    <div class="publication-cover">

                        <img
                            src="<%= currentPublication.coverUrl || '/images/logo.jpg' %>"
                            alt="<%= currentPublication.title %>"
                            onerror="this.src='/images/logo.jpg'"
                        >

                    </div>


                    <!-- INFORMATION -->
                    <div class="publication-info">

                        <span class="publication-label">
                            CURRENT ISSUE
                        </span>


                        <h2>
                            <%= currentPublication.title %>
                        </h2>


                        <% if (currentPublication.year) { %>

                            <div class="publication-year">
                                <%= currentPublication.year %>
                            </div>

                        <% } %>


                        <p class="publication-description">

                            <%= currentPublication.description ||
                                'Explore this publication from KSK Foundation.' %>

                        </p>


                        <div class="publication-actions">

                            <% if (currentPublication.documentUrl) { %>

                                <!-- READ -->
                                <a
                                    href="<%= currentPublication.documentUrl %>"
                                    class="btn primary"
                                    data-reader-pdf="<%= currentPublication.documentUrl %>"
                                    data-reader-title="<%= currentPublication.title %>"
                                >
                                    Read Current Issue
                                </a>


                                <!-- DOWNLOAD -->
                                <a
                                    href="<%= currentPublication.documentUrl %>"
                                    class="btn btn-outline"
                                    download
                                >
                                    Download
                                </a>

                            <% } else { %>

                                <span class="publication-unavailable">
                                    Magazine document unavailable.
                                </span>

                            <% } %>

                        </div>

                    </div>

                </div>

            <% } else { %>


                <!-- NO CURRENT PUBLICATION -->

                <div class="publication-empty">

                    <h3>
                        No publications available yet
                    </h3>

                    <p>
                        Our latest publication will appear here
                        once it has been published.
                    </p>

                </div>

            <% } %>

        </div>

    </section>



    <!-- =====================================================
         PUBLICATION ARCHIVE
    ====================================================== -->

    <section
        class="section publication-archive"
        id="focus-archive"
    >

        <div class="container">


            <div class="section-heading">

                <span class="section-eyebrow">
                    MAGAZINE ARCHIVE
                </span>

                <h2>
                    Previous Issues
                </h2>

                <p>
                    Browse all published issues of
                    KSK Foundation publications.
                </p>

            </div>



            <% if (publications && publications.length > 0) { %>


                <div class="magazine-archive-list">


                    <% publications.forEach(function(pub) { %>


                        <!-- =================================================
                             INDIVIDUAL PUBLICATION
                        ================================================== -->

                        <article
                            class="magazine-archive-card"
                            id="publication-<%= pub.id %>"
                        >


                            <!-- COVER -->

                            <div class="magazine-archive-cover">

                                <img
                                    src="<%= pub.coverUrl || '/images/logo.jpg' %>"
                                    alt="<%= pub.title %>"
                                    loading="lazy"
                                    onerror="this.src='/images/logo.jpg'"
                                >

                            </div>



                            <!-- CONTENT -->

                            <div class="magazine-archive-content">


                                <% if (pub.year) { %>

                                    <span class="archive-year">
                                        <%= pub.year %>
                                    </span>

                                <% } %>


                                <h3>
                                    <%= pub.title %>
                                </h3>


                                <p class="archive-description">

                                    <%= pub.description ||
                                        'Explore this publication from KSK Foundation.' %>

                                </p>



                                <!-- ACTIONS -->

                                <div class="archive-actions">


                                    <% if (pub.documentUrl) { %>


                                        <!-- READ -->

                                        <a
                                            href="<%= pub.documentUrl %>"
                                            class="btn primary"
                                            data-reader-pdf="<%= pub.documentUrl %>"
                                            data-reader-title="<%= pub.title %>"
                                        >
                                            Read Magazine
                                        </a>



                                        <!-- DOWNLOAD -->

                                        <a
                                            href="<%= pub.documentUrl %>"
                                            class="btn btn-outline"
                                            download
                                        >
                                            Download
                                        </a>


                                    <% } else { %>


                                        <span class="publication-unavailable">
                                            Document unavailable
                                        </span>


                                    <% } %>


                                </div>


                            </div>


                        </article>


                    <% }); %>


                </div>


            <% } else { %>


                <!-- =================================================
                     EMPTY ARCHIVE
                ================================================== -->

                <div class="publication-empty">

                    <div class="publication-empty-icon">
                        +
                    </div>

                    <h3>
                        Publications Coming Soon
                    </h3>

                    <p>
                        Published publications will automatically
                        appear here.
                    </p>

                </div>


            <% } %>


        </div>

    </section>



    <!-- =====================================================
         PDF READER

         Your existing JavaScript should detect:
         data-reader-pdf
         data-reader-title
    ====================================================== -->

    <div
        class="pdf-reader-overlay"
        id="pdfReader"
        aria-hidden="true"
    >

        <div class="pdf-reader-container">


            <!-- READER HEADER -->

            <div class="pdf-reader-header">

                <div>

                    <span class="pdf-reader-label">
                        KSK FOUNDATION
                    </span>

                    <h2 id="pdfReaderTitle">
                        Publication
                    </h2>

                </div>


                <button
                    type="button"
                    class="pdf-reader-close"
                    id="pdfReaderClose"
                    aria-label="Close publication reader"
                >
                    &times;
                </button>

            </div>



            <!-- READER CONTENT -->

            <div
                class="pdf-reader-body"
                id="pdfReaderBody"
            >

                <!-- Your existing PDF reader JavaScript
                     will populate this area. -->

            </div>



            <!-- READER FOOTER -->

            <div class="pdf-reader-footer">

                <a
                    href="#"
                    class="btn primary"
                    id="pdfReaderDownload"
                    download
                >
                    Download Magazine
                </a>

            </div>


        </div>

    </div>



    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <%- include('partials/footer') %>


    <!-- =====================================================
         SCRIPTS
    ====================================================== -->

    <script
        src="/js/publications.js"
        defer
    ></script>

</body>

</html>
