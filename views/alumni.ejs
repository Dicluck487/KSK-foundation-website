<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Alumni Voices — KSK Foundation</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>

        /* =========================================================
           KSK FOUNDATION — ALUMNI VOICES
        ========================================================= */

        .alumni-page {
            background: #f8f8f6;
            color: #111827;
        }

        /* HERO */

        .alumni-hero {
            position: relative;
            padding: 110px 20px 100px;
            background:
                linear-gradient(
                    110deg,
                    rgba(8, 24, 49, 0.96),
                    rgba(8, 24, 49, 0.82)
                );
            overflow: hidden;
        }

        .alumni-hero-inner {
            max-width: 1180px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }

        .alumni-eyebrow {
            display: inline-block;
            margin-bottom: 18px;
            color: #e47b00;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .alumni-hero h1 {
            max-width: 800px;
            margin: 0 0 24px;
            color: #ffffff;
            font-size: clamp(42px, 7vw, 76px);
            line-height: 1.02;
            font-weight: 700;
        }

        .alumni-hero p {
            max-width: 680px;
            margin: 0;
            color: rgba(255, 255, 255, 0.82);
            font-size: 19px;
            line-height: 1.7;
        }


        /* INTRO */

        .alumni-intro {
            max-width: 850px;
            margin: 0 auto;
            padding: 80px 20px 50px;
            text-align: center;
        }

        .alumni-intro h2 {
            margin: 0 0 18px;
            color: #111827;
            font-size: clamp(30px, 4vw, 44px);
            line-height: 1.15;
        }

        .alumni-intro p {
            margin: 0;
            color: #526176;
            font-size: 17px;
            line-height: 1.8;
        }


        /* YEAR NAVIGATION */

        .alumni-year-nav {
            position: sticky;
            top: 0;
            z-index: 20;
            background: rgba(248, 248, 246, 0.96);
            border-top: 1px solid #e5e7eb;
            border-bottom: 1px solid #e5e7eb;
            backdrop-filter: blur(12px);
        }

        .alumni-year-nav-inner {
            max-width: 1180px;
            margin: 0 auto;
            padding: 16px 20px;

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;

            overflow-x: auto;
        }

        .alumni-year-nav a {
            flex: 0 0 auto;
            padding: 9px 18px;
            border: 1px solid #d9dde3;
            border-radius: 30px;
            color: #26364e;
            background: #ffffff;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .alumni-year-nav a:hover {
            color: #ffffff;
            background: #0b2545;
            border-color: #0b2545;
        }


        /* ARCHIVE */

        .alumni-archive {
            max-width: 1180px;
            margin: 0 auto;
            padding: 50px 20px 100px;
        }

        .alumni-year-section {
            margin-bottom: 90px;
            scroll-margin-top: 90px;
        }

        .year-heading {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 45px;
        }

        .year-heading h2 {
            margin: 0;
            color: #0b2545;
            font-size: clamp(36px, 5vw, 56px);
            line-height: 1;
        }

        .year-heading-line {
            height: 1px;
            flex: 1;
            background: #d9dde3;
        }


        /* PROGRAM */

        .program-group {
            margin-bottom: 55px;
        }

        .program-heading {
            margin-bottom: 24px;
        }

        .program-heading span {
            display: block;
            margin-bottom: 7px;
            color: #e07800;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .program-heading h3 {
            margin: 0;
            color: #111827;
            font-size: 25px;
            line-height: 1.3;
        }


        /* CARDS */

        .alumni-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 26px;
        }

        .alumni-card {
            overflow: hidden;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 7px 28px rgba(15, 23, 42, 0.07);
            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }

        .alumni-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 38px rgba(15, 23, 42, 0.12);
        }

        .alumni-card-image {
            height: 250px;
            overflow: hidden;
            background: #e9edf2;
        }

        .alumni-card-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .alumni-card:hover .alumni-card-image img {
            transform: scale(1.04);
        }

        .alumni-card-content {
            padding: 25px 24px 28px;
        }

        .alumni-card-name {
            margin: 0 0 8px;
            color: #111827;
            font-size: 21px;
            line-height: 1.3;
        }

        .alumni-card-program {
            display: inline-block;
            margin-bottom: 18px;
            color: #e07800;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .alumni-card-testimonial {
            margin: 0;
            color: #34445b;
            font-size: 15px;
            line-height: 1.75;
        }

        .alumni-card-testimonial::before {
            content: "“";
            display: block;
            margin-bottom: -5px;
            color: #e07800;
            font-family: Georgia, serif;
            font-size: 38px;
            line-height: 1;
        }


        /* EMPTY PROGRAM */

        .program-empty {
            padding: 25px;
            border: 1px dashed #d5dae1;
            border-radius: 14px;
            color: #788396;
            background: rgba(255,255,255,0.5);
            font-size: 14px;
        }


        /* EMPTY ARCHIVE */

        .alumni-empty {
            padding: 70px 30px;
            border-radius: 20px;
            background: #ffffff;
            text-align: center;
            box-shadow: 0 7px 28px rgba(15, 23, 42, 0.05);
        }

        .alumni-empty h3 {
            margin: 0 0 10px;
            color: #111827;
        }

        .alumni-empty p {
            margin: 0;
            color: #68758a;
        }


        /* RESPONSIVE */

        @media (max-width: 950px) {

            .alumni-grid {
                grid-template-columns: repeat(2, 1fr);
            }

        }


        @media (max-width: 650px) {

            .alumni-hero {
                padding: 80px 20px;
            }

            .alumni-hero h1 {
                font-size: 45px;
            }

            .alumni-intro {
                padding-top: 60px;
            }

            .alumni-grid {
                grid-template-columns: 1fr;
            }

            .alumni-card-image {
                height: 280px;
            }

            .year-heading {
                gap: 12px;
            }

            .year-heading-line {
                display: none;
            }

            .alumni-year-section {
                margin-bottom: 65px;
            }

        }

    </style>
</head>


<body>

<div class="alumni-page">


    <!-- HERO -->

    <section class="alumni-hero">

        <div class="alumni-hero-inner">

            <span class="alumni-eyebrow">
                ALUMNI VOICES
            </span>

            <h1>
                Stories of Growth,
                Impact and Possibility.
            </h1>

            <p>
                Meet the young people whose experiences with KSK Foundation
                continue to shape their journeys, careers and communities.
            </p>

        </div>

    </section>


    <!-- INTRO -->

    <section class="alumni-intro">

        <h2>
            From Participants to Changemakers
        </h2>

        <p>
            Every KSK experience is part of a larger journey. These voices
            capture the experiences, lessons and transformations of alumni
            from across our programs and years.
        </p>

    </section>


    <% if (years && years.length > 0) { %>

        <!-- YEAR NAVIGATION -->

        <nav class="alumni-year-nav">

            <div class="alumni-year-nav-inner">

                <% years.forEach(year => { %>

                    <a href="#year-<%= year %>">
                        <%= year %>
                    </a>

                <% }) %>

            </div>

        </nav>


        <!-- ARCHIVE -->

        <main class="alumni-archive">

            <% years.forEach(year => { %>

                <section
                    class="alumni-year-section"
                    id="year-<%= year %>"
                >

                    <div class="year-heading">

                        <h2>
                            <%= year %>
                        </h2>

                        <div class="year-heading-line"></div>

                    </div>


                    <% programs.forEach(program => { %>

                        <%
                            const programAlumni = alumni.filter(
                                a =>
                                    Number(a.year) === Number(year) &&
                                    a.program === program
                            );
                        %>


                        <% if (programAlumni.length > 0) { %>

                            <div class="program-group">

                                <div class="program-heading">

                                    <span>
                                        Program
                                    </span>

                                    <h3>
                                        <%= program %>
                                    </h3>

                                </div>


                                <div class="alumni-grid">

                                    <% programAlumni.forEach(a => { %>

                                        <article class="alumni-card">

                                            <% if (a.image_url || a.photo_path) { %>

                                                <div class="alumni-card-image">

                                                    <img
                                                        src="<%= a.image_url || a.photo_path %>"
                                                        alt="<%= a.name %>"
                                                        loading="lazy"
                                                    >

                                                </div>

                                            <% } %>


                                            <div class="alumni-card-content">

                                                <h4 class="alumni-card-name">
                                                    <%= a.name %>
                                                </h4>

                                                <span class="alumni-card-program">
                                                    <%= program %>
                                                </span>

                                                <p class="alumni-card-testimonial">
                                                    <%= a.testimonial %>
                                                </p>

                                            </div>

                                        </article>

                                    <% }) %>

                                </div>

                            </div>

                        <% } %>

                    <% }) %>

                </section>

            <% }) %>

        </main>


    <% } else { %>

        <section class="alumni-archive">

            <div class="alumni-empty">

                <h3>
                    Alumni Voices Coming Soon
                </h3>

                <p>
                    Alumni stories will appear here as they are published.
                </p>

            </div>

        </section>

    <% } %>

</div>

</body>

</html>