<script>
document.addEventListener('DOMContentLoaded', () => {

  /* =========================================================
     ALUMNI SECTION REVEAL ANIMATION
  ========================================================= */

  const revealItems = document.querySelectorAll(
    '.alumni-intro, .testimonials-section, .alumni-programs, ' +
    '.mentor-voice, .partner-voice, .alumni-directory, .collection-section'
  );

  if ('IntersectionObserver' in window) {

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {

        entries.forEach(entry => {

          if (entry.isIntersecting) {
            entry.target.classList.add('alumni-visible');
            observer.unobserve(entry.target);
          }

        });

      },
      {
        threshold: 0.12
      }
    );

    revealItems.forEach(section => {
      section.classList.add('alumni-reveal');
      revealObserver.observe(section);
    });

  } else {

    revealItems.forEach(section => {
      section.classList.add('alumni-visible');
    });

  }


  /* =========================================================
     ALUMNI DIRECTORY FILTER
  ========================================================= */

  const directoryGroups = document.querySelectorAll('.directory-group');

  if (directoryGroups.length > 0) {

    const filterWrapper = document.createElement('div');

    filterWrapper.className = 'alumni-directory-filters';

    filterWrapper.innerHTML = `
      <button type="button" class="directory-filter active" data-filter="all">
        All
      </button>

      <button type="button" class="directory-filter" data-filter="MSWRP">
        MSWRP
      </button>

      <button type="button" class="directory-filter" data-filter="Kaizen">
        Kaizen Teen Boot Camp
      </button>

      <button type="button" class="directory-filter" data-filter="Financial">
        Financial Services Academy
      </button>
    `;

    const directorySection = document.querySelector('.alumni-directory');
    const directoryHeading = directorySection.querySelector('.section-heading');

    if (directoryHeading) {
      directoryHeading.insertAdjacentElement(
        'afterend',
        filterWrapper
      );
    }


    /* Add searchable identifiers to each group */

    directoryGroups.forEach(group => {

      const title = group
        .querySelector('.directory-heading h3')
        ?.textContent
        .trim()
        .toLowerCase();

      if (title.includes('mswrp')) {
        group.dataset.program = 'MSWRP';
      }

      else if (title.includes('kaizen')) {
        group.dataset.program = 'Kaizen';
      }

      else if (title.includes('financial')) {
        group.dataset.program = 'Financial';
      }

    });


    /* Handle filter clicks */

    const filterButtons =
      document.querySelectorAll('.directory-filter');

    filterButtons.forEach(button => {

      button.addEventListener('click', () => {

        filterButtons.forEach(btn => {
          btn.classList.remove('active');
        });

        button.classList.add('active');

        const selectedFilter =
          button.dataset.filter;

        directoryGroups.forEach(group => {

          if (
            selectedFilter === 'all' ||
            group.dataset.program === selectedFilter
          ) {

            group.style.display = '';

            requestAnimationFrame(() => {
              group.classList.remove('directory-hidden');
            });

          } else {

            group.classList.add('directory-hidden');

            setTimeout(() => {
              group.style.display = 'none';
            }, 250);

          }

        });

      });

    });

  }


  /* =========================================================
     PREVENT EMPTY TESTIMONIAL SECTION
  ========================================================= */

  const testimonialGrid =
    document.querySelector('.testimonial-grid');

  if (testimonialGrid) {

    const testimonialCards =
      testimonialGrid.querySelectorAll('.testimonial-card');

    if (testimonialCards.length === 0) {

      testimonialGrid.innerHTML = `
        <div class="no-alumni-message">
          <h3>Alumni stories coming soon</h3>
          <p>
            We are collecting stories from our alumni community.
            Check back soon to hear their experiences.
          </p>
        </div>
      `;

    }

  }

});
</script>