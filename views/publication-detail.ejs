<section class="page-header">
  <div class="container">
    <h1><%= publication.title %></h1>
    <p><%= publication.description %></p>
  </div>
</section>

<section class="section">
  <div class="container narrow center">
    <img src="../public/images/images.jpg" alt="<%= publication.title %>" class="rounded-img tall">
    <p>Embed a PDF viewer, flipbook, or download link for this publication here.</p>
    <a href="/publications" class="btn btn-outline">&larr; Back To Publications</a>
  </div>
</section>
