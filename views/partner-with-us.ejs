<!-- =========================================================
     PAGE CSS
========================================================= -->

<style>

  /* =========================================================
     HEADER
  ========================================================= */

  .partner-header {
    position: relative;
    overflow: hidden;
  }

  .partner-header .section-eyebrow {
    color: rgba(255,255,255,0.85);
  }

  .partner-header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }


  /* =========================================================
     SHARED
  ========================================================= */

  .partner-with-us-page .section-eyebrow,
  .partner-intro .section-eyebrow,
  .why-partner .section-eyebrow,
  .partnership-options .section-eyebrow,
  .partnership-message .section-eyebrow,
  .partner-contact .section-eyebrow {
    color: var(--color-primary, #e0392c);
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 45px;
  }

  .section-heading.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .section-heading h2 {
    margin: 0 0 15px;
  }

  .section-heading p {
    margin: 0;
    color: var(--color-muted, #6b7280);
    line-height: 1.8;
  }


  /* =========================================================
     INTRO
  ========================================================= */

  .partner-intro {
    padding-bottom: 50px;
  }

  .partner-intro-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 80px;
    align-items: center;
  }

  .partner-intro-grid h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.15;
  }

  .partner-intro-grid p {
    margin: 0 0 18px;
    color: var(--color-muted, #6b7280);
    line-height: 1.85;
    font-size: 1.03rem;
  }


  /* =========================================================
     IMPACT STATS
  ========================================================= */

  .partner-stats {
    padding-top: 20px;
    padding-bottom: 20px;
    background: var(--color-dark, #14161a);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .impact-stat {
    padding: 35px 25px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,0.1);
  }

  .impact-stat:last-child {
    border-right: 0;
  }

  .impact-number {
    display: block;
    margin-bottom: 10px;
    color: var(--color-primary, #e0392c);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1;
  }

  .impact-label {
    display: block;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .impact-description {
    display: block;
    margin-top: 10px;
    color: rgba(255,255,255,0.5);
    font-size: 0.75rem;
    line-height: 1.4;
  }


  /* =========================================================
     WHY PARTNER
  ========================================================= */

  .why-partner {
    background: var(--color-bg-alt, #f6f5f3);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .benefit-card {
    position: relative;
    padding: 32px;
    min-height: 270px;
    border-radius: 18px;
    background: #eba852;
    border: 1px solid rgba(0,0,0,0.06);
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .benefit-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.08);
  }

  .benefit-number {
    position: absolute;
    top: 15px;
    right: 22px;
    color: rgba(0,0,0,0.06);
    font-size: 2.5rem;
    font-weight: 900;
  }

  .benefit-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    border-radius: 50%;
    background: rgba(224,57,44,0.09);
    color: var(--color-primary, #e0392c);
    font-size: 0.72rem;
    font-weight: 900;
  }

  .benefit-card h3 {
    margin: 0 0 12px;
    font-size: 1.08rem;
  }

  .benefit-card p {
    margin: 0;
    color: var(--color-muted, #6b7280);
    line-height: 1.7;
    font-size: 0.9rem;
  }


  /* =========================================================
     PARTNERSHIP OPTIONS
  ========================================================= */

  .partnership-options {
    background: #faf9f8;
  }

  .partnership-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .partnership-card {
    position: relative;
    padding: 35px;
    border-radius: 20px;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 8px 25px rgba(0,0,0,0.04);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .partnership-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(0,0,0,0.09);
  }

  .partnership-card.featured-partnership {
    border-top: 4px solid var(--color-primary, #e0392c);
  }

  .featured-label {
    position: absolute;
    top: 20px;
    right: 22px;
    padding: 6px 10px;
    border-radius: 20px;
    background: rgba(224,57,44,0.09);
    color: var(--color-primary, #e0392c);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .partnership-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 25px;
  }

  .partnership-number {
    color: var(--color-primary, #e0392c);
    font-size: 0.75rem;
    font-weight: 900;
  }

  .partnership-icon {
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-dark, #14161a);
    color: #fff;
    font-size: 1.3rem;
  }

  .partnership-card h3 {
    margin: 0 0 12px;
    font-size: 1.35rem;
  }

  .partnership-card > p {
    margin: 0 0 20px;
    color: var(--color-muted, #6b7280);
    line-height: 1.7;
  }

  .partnership-card ul {
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  .partnership-card li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
    color: var(--color-text, #2b2b2b);
    font-size: 0.88rem;
  }

  .partnership-card li::before {
    content: " ";
    position: absolute;
    left: 0;
    color: var(--color-primary, #e0392c);
    font-weight: 900;
  }

  .partnership-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-primary, #e0392c);
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none;
  }

  .partnership-link span {
    transition: transform 0.2s ease;
  }

  .partnership-link:hover span {
    transform: translateX(5px);
  }


  /* =========================================================
     PARTNERSHIP MESSAGE
  ========================================================= */

  .partnership-message {
    background: var(--color-bg-alt, #f6f5f3);
  }

  .partnership-message-card {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 30px;
    align-items: flex-start;
    padding: 55px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 15px 40px rgba(0,0,0,0.06);
  }

  .message-quote {
    font-size: 7rem;
    line-height: 0.6;
    color: var(--color-primary, #e0392c);
  }

  .message-content blockquote {
    max-width: 850px;
    margin: 10px 0 30px;
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    line-height: 1.6;
    font-weight: 600;
  }


  /* =========================================================
     CONTACT
  ========================================================= */

  .partner-contact {
    background: #fff;
  }

  .partner-contact-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: center;
  }

  .partner-contact-grid h2 {
    margin: 0 0 15px;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .partner-contact-grid p {
    max-width: 700px;
    margin: 0;
    color: var(--color-muted, #6b7280);
    line-height: 1.8;
  }

  .partner-contact-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .partner-contact-action > span {
    color: var(--color-muted, #6b7280);
    font-size: 0.75rem;
  }


  /* =========================================================
     RESPONSIVE
  ========================================================= */

  @media (max-width: 1000px) {

    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .impact-stat:nth-child(2) {
      border-right: 0;
    }

    .impact-stat:nth-child(-n+2) {
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

  }


  @media (max-width: 800px) {

    .partner-intro-grid,
    .partner-contact-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .partnership-grid {
      grid-template-columns: 1fr;
    }

    .partner-contact-action {
      align-items: flex-start;
      text-align: left;
    }

  }


  @media (max-width: 600px) {

    .partner-header-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .partner-header-actions .btn {
      text-align: center;
    }

    .benefits-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .impact-stat {
      border-right: 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .impact-stat:last-child {
      border-bottom: 0;
    }

    .partnership-card,
    .partnership-message-card {
      padding: 28px 22px;
    }

    .partnership-message-card {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .message-quote {
      font-size: 5rem;
    }

  }

</style>


