<!-- =========================================================
     PAGE CSS
========================================================= -->
<link rel="stylesheet" href="/css/style.css">
<style>

  /* =========================================================
     HEADER
  ========================================================= */

  .partner-header {
    position: relative;
    overflow: hidden;
  }

  .partner-header .section-eyebrow {
    color: rgba(255,255,255,0.85);
  }

  .partner-header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }


  /* =========================================================
     SHARED
  ========================================================= */

  .partner-with-us-page .section-eyebrow,
  .partner-intro .section-eyebrow,
  .why-partner .section-eyebrow,
  .partnership-options .section-eyebrow,
  .partnership-message .section-eyebrow,
  .partner-contact .section-eyebrow {
    color: var(--color-primary, #e0392c);
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 45px;
  }

  .section-heading.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .section-heading h2 {
    margin: 0 0 15px;
  }

  .section-heading p {
    margin: 0;
    color: var(--color-muted, #6b7280);
    line-height: 1.8;
  }


  /* =========================================================
     INTRO
  ========================================================= */

  .partner-intro {
    padding-bottom: 50px;
  }

  .partner-intro-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 80px;
    align-items: center;
  }

  .partner-intro-grid h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.15;
  }

  .partner-intro-grid p {
    margin: 0 0 18px;
    color: var(--color-muted, #6b7280);
    line-height: 1.85;
    font-size: 1.03rem;
  }


  /* =========================================================
     IMPACT STATS
  ========================================================= */

  .partner-stats {
    padding-top: 20px;
    padding-bottom: 20px;
    background: var(--color-dark, #14161a);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .impact-stat {
    padding: 35px 25px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,0.1);
  }

  .impact-stat:last-child {
    border-right: 0;
  }

  .impact-number {
    display: block;
    margin-bottom: 10px;
    color: var(--color-primary, #e0392c);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1;
  }

  .impact-label {
    display: block;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .impact-description {
    display: block;
    margin-top: 10px;
    color: rgba(255,255,255,0.5);
    font-size: 0.75rem;
    line-height: 1.4;
  }


  /* =========================================================
     WHY PARTNER
  ========================================================= */

  .why-partner {
    background: var(--color-bg-alt, #f6f5f3);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .benefit-card {
    padding: 26px 22px;
    min-height: 270px;
  }

  .benefit-card {
    position: relative;
    padding: 32px;
    min-height: 270px;
    border-radius: 18px;
    background: #eba852;
    border: 1px solid rgba(0,0,0,0.06);
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .benefit-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.08);
  }

  /* Partner benefit cards — two orange and two purple */
  .benefit-card.partner-benefit-orange {
    background: #eba852;
    border-color: #eba852;
  }

  .benefit-card.partner-benefit-purple {
    background: #30206f;
    border-color: #30206f;
  }

  .benefit-card.partner-benefit-orange h3,
  .benefit-card.partner-benefit-orange p,
  .benefit-card.partner-benefit-purple h3,
  .benefit-card.partner-benefit-purple p {
    color: #fff;
  }

  .benefit-card.partner-benefit-orange .benefit-icon,
  .benefit-card.partner-benefit-purple .benefit-icon {
    background: rgba(255,255,255,0.14);
    color: #ffd21c;
  }

  .benefit-card.partner-benefit-orange .benefit-number,
  .benefit-card.partner-benefit-purple .benefit-number {
    color: rgba(255,255,255,0.12);
  }

  .benefit-number {
    position: absolute;
    top: 15px;
    right: 22px;
    color: rgba(0,0,0,0.06);
    font-size: 2.5rem;
    font-weight: 900;
  }

  .benefit-icon {
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    border-radius: 50%;
    background: rgba(224,57,44,0.09);
    color: var(--color-primary, #e0392c);
    font-size: 1.2rem;
    font-weight: 900;
  }

  .benefit-card h3 {
    margin: 0 0 12px;
    font-size: 1.08rem;
  }

  .benefit-card p {
    margin: 0;
    color: var(--color-muted, #6b7280);
    line-height: 1.7;
    font-size: 0.9rem;
  }


  /* =========================================================
     PARTNERSHIP OPTIONS
  ========================================================= */

  .partnership-options {
    background: #faf9f8;
  }

  .partnership-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .partnership-card {
    position: relative;
    padding: 35px;
    border-radius: 20px;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: 0 8px 25px rgba(0,0,0,0.04);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .partnership-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(0,0,0,0.09);
  }

  .partnership-card.featured-partnership {
    border-top: 4px solid var(--color-primary, #e0392c);
  }

  .featured-label {
    position: absolute;
    top: 20px;
    right: 22px;
    padding: 6px 10px;
    border-radius: 20px;
    background: rgba(224,57,44,0.09);
    color: var(--color-primary, #e0392c);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .partnership-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 25px;
  }

  .partnership-number {
    color: var(--color-primary, #e0392c);
    font-size: 0.75rem;
    font-weight: 900;
  }

  .partnership-icon {
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-dark, #14161a);
    color: #fff;
    font-size: 1.3rem;
  }

  .partnership-card h3 {
    margin: 0 0 12px;
    font-size: 1.35rem;
  }

  .partnership-card > p {
    margin: 0 0 20px;
    color: var(--color-muted, #6b7280);
    line-height: 1.7;
  }

  .partnership-card ul {
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  .partnership-card li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
    color: var(--color-text, #2b2b2b);
    font-size: 0.88rem;
  }

  .partnership-card li::before {
    content: " ";
    position: absolute;
    left: 0;
    color: var(--color-primary, #e0392c);
    font-weight: 900;
  }

  .partnership-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-primary, #e0392c);
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none;
  }

  .partnership-link span {
    transition: transform 0.2s ease;
  }

  .partnership-link:hover span {
    transform: translateX(5px);
  }


  /* =========================================================
     PARTNERSHIP MESSAGE
  ========================================================= */

  .partnership-message {
    background: var(--color-bg-alt, #f6f5f3);
  }

  .partnership-message-card {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 30px;
    align-items: flex-start;
    padding: 55px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 15px 40px rgba(0,0,0,0.06);
  }

  .message-quote {
    font-size: 7rem;
    line-height: 0.6;
    color: var(--color-primary, #e0392c);
  }

  .message-content blockquote {
    max-width: 850px;
    margin: 10px 0 30px;
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    line-height: 1.6;
    font-weight: 600;
  }


  /* =========================================================
     PARTNER VOICE — FEATURE TILE
  ========================================================= */

  .partner-voice {
    background: #f6f5f3;
    padding-top: 75px;
    padding-bottom: 75px;
  }

  .partner-voice-tile {
    position: relative;
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    min-height: 430px;
    overflow: hidden;
    border-radius: 28px;
    background: #30206f;
    box-shadow: 0 24px 60px rgba(48,32,111,0.18);
  }

  .partner-voice-tile::before {
    content: "";
    position: absolute;
    width: 280px;
    height: 280px;
    right: -100px;
    top: -120px;
    border-radius: 50%;
    background: rgba(235,168,82,0.18);
  }

  .partner-voice-tile::after {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    left: -80px;
    bottom: -90px;
    border-radius: 50%;
    background: rgba(235,168,82,0.10);
  }

  .partner-voice-intro {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 55px;
    background: linear-gradient(145deg, #561358 0%, #611968 100%);
    color: #fff;
  }

  .voice-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    width: fit-content;
    margin-bottom: 24px;
    color: #eba852;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.16em;
  }

  .voice-badge-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #eba852;
    box-shadow: 0 0 0 5px rgba(235,168,82,0.14);
  }

  .partner-voice-intro h2 {
    max-width: 430px;
    margin: 0 0 20px;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.08;
  }

  .partner-voice-intro p {
    max-width: 450px;
    margin: 0;
    color: rgba(255,255,255,0.76);
    font-size: 1rem;
    line-height: 1.8;
  }

  .voice-line {
    width: 65px;
    height: 4px;
    margin-top: 30px;
    border-radius: 10px;
    background: #eba852;
  }

  .voice-caption {
    margin-top: 13px;
    color: rgba(255,255,255,0.55);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .partner-quote-panel {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 55px 65px;
    background: #fff;
  }

  .quote-symbol {
    position: absolute;
    top: 28px;
    right: 45px;
    color: #eba852;
    font-family: Georgia, serif;
    font-size: 8rem;
    line-height: 0.8;
    opacity: 0.3;
  }

  .partner-quote-panel blockquote {
    position: relative;
    max-width: 760px;
    margin: 0 0 35px;
    color: #30206f;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 600;
    line-height: 1.65;
  }

