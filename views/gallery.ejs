<!--
  views/gallery.ejs
  Expects: `photos` — an array from getPublishedGallery(), each item:
    { id, title, description, url, category, year, alt_text }

  Route example (routes/index.js):
    const { getPublishedGallery } = require('../controllers/galleryController');
    router.get('/gallery', async (req, res) => {
      const photos = await getPublishedGallery();
      res.render('gallery', { title: 'Gallery', photos });
    });
-->

<section class="ksk-gallery-hero">
  <div class="ksk-gallery-wrap">
    <p class="ksk-gallery-eyebrow">KSK Foundation</p>
    <h1>Gallery</h1>
    <p class="ksk-gallery-sub">Moments from our programs, cohorts, and community — captured across the field.</p>
  </div>
</section>

<section class="ksk-gallery-body">
  <div class="ksk-gallery-wrap">

    <% if (!photos || photos.length === 0) { %>
      <div class="ksk-gallery-empty">
        <p>No photos published yet — check back soon.</p>
      </div>
    <% } else { %>

      <%
        // Build the unique, ordered list of categories present in this data set
        const categories = ['All', ...new Set(photos.map(p => p.category).filter(Boolean))];
      %>

      <div class="ksk-gallery-filters" role="tablist" aria-label="Filter gallery by category">
        <% categories.forEach((cat, i) => { %>
          <button
            type="button"
            class="ksk-filter-pill <%= i === 0 ? 'active' : '' %>"
            data-filter="<%= cat === 'All' ? 'all' : cat %>"
          ><%= cat %></button>
        <% }) %>
      </div>

      <div class="ksk-gallery-grid">
        <% photos.forEach(photo => { %>
          <figure
            class="ksk-gallery-item"
            data-category="<%= photo.category || '' %>"
          >
            <button
              type="button"
              class="ksk-gallery-thumb-btn"
              data-full="<%= photo.url %>"
              data-caption="<%= (photo.title || '') + (photo.year ? ' · ' + photo.year : '') %>"
              aria-label="View <%= photo.title || 'photo' %> full size"
            >
              <img
                src="<%= photo.url %>"
                alt="<%= photo.alt_text || photo.title || 'KSK Foundation gallery photo' %>"
                loading="lazy"
              >
              <span class="ksk-gallery-zoom-icon" aria-hidden="true">⤢</span>
            </button>
            <% if (photo.title || photo.category) { %>
              <figcaption>
                <% if (photo.title) { %><span class="ksk-caption-title"><%= photo.title %></span><% } %>
                <% if (photo.category) { %><span class="ksk-caption-tag"><%= photo.category %></span><% } %>
              </figcaption>
            <% } %>
          </figure>
        <% }) %>
      </div>

      <p class="ksk-gallery-empty-filtered" hidden>No photos in this category yet.</p>

    <% } %>
  </div>
</section>

<!-- Lightbox -->
<div class="ksk-lightbox" id="kskLightbox" aria-hidden="true">
  <button type="button" class="ksk-lightbox-close" id="kskLightboxClose" aria-label="Close">&times;</button>
  <figure>
    <img id="kskLightboxImg" src="" alt="">
    <figcaption id="kskLightboxCaption"></figcaption>
  </figure>
</div>

<style>
  .ksk-gallery-hero {
    background: linear-gradient(135deg, #2b0f4a 0%, #6a2fb8 55%, #b23fd6 100%);
    color: #fff;
    padding: 32px 12px 28px;
    text-align: center;
  }
  .ksk-gallery-wrap { max-width: 1180px; margin: 0 auto; }
  .ksk-gallery-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 12.5px;
    font-weight: 600;
    opacity: 0.85;
    margin: 0 0 10px;
  }
  .ksk-gallery-hero h1 {
    font-size: clamp(32px, 5vw, 48px);
    margin: 0 0 12px;
    font-weight: 500;
  }
  .ksk-gallery-sub {
    max-width: 560px;
    margin: 0 auto;
    color: rgba(255,255,255,0.88);
    font-size: 16px;
    line-height: 1.6;
  }

  .ksk-gallery-body { padding: 48px 24px 80px; background: #faf9fc; }

  .ksk-gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 36px;
  }
  .ksk-filter-pill {
    border: 1px solid #e2d9f0;
    background: #fff;
    color: #4a3a63;
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .ksk-filter-pill:hover { border-color: #b23fd6; color: #6a2fb8; }
  .ksk-filter-pill.active { background: #6a2fb8; border-color: #6a2fb8; color: #fff; }

  .ksk-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }

  .ksk-gallery-item {
    margin: 0;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(20, 10, 40, 0.06);
    border: 1px solid #efe9f5;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ksk-gallery-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(80, 30, 140, 0.13);
  }

  .ksk-gallery-thumb-btn {
    all: unset;
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    cursor: zoom-in;
    overflow: hidden;
  }
  .ksk-gallery-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .ksk-gallery-thumb-btn:hover img { transform: scale(1.06); }

  .ksk-gallery-zoom-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(20, 10, 40, 0.55);
    color: #fff;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .ksk-gallery-thumb-btn:hover .ksk-gallery-zoom-icon { opacity: 1; }

  .ksk-gallery-item figcaption {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ksk-caption-title { font-size: 14px; font-weight: 600; color: #2b1a45; }
  .ksk-caption-tag {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #8a6fb5;
    font-weight: 600;
  }

  .ksk-gallery-empty,
  .ksk-gallery-empty-filtered {
    text-align: center;
    color: #7a6d8f;
    padding: 60px 20px;
    font-size: 15px;
  }

  /* Lightbox */
  .ksk-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(15, 8, 28, 0.92);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 32px;
  }
  .ksk-lightbox.open { display: flex; }
  .ksk-lightbox figure { margin: 0; max-width: 92vw; max-height: 88vh; text-align: center; }
  .ksk-lightbox img {
    max-width: 92vw;
    max-height: 78vh;
    border-radius: 10px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }
  .ksk-lightbox figcaption {
    color: #f1e9fb;
    font-size: 14px;
    margin-top: 14px;
  }
  .ksk-lightbox-close {
    position: absolute;
    top: 20px;
    right: 28px;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 34px;
    line-height: 1;
    cursor: pointer;
  }

  @media (max-width: 480px) {
    .ksk-gallery-hero { padding: 24px 9px 20px; }
    .ksk-gallery-body { padding: 36px 16px 60px; }
    .ksk-gallery-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
  }
</style>

<script>
  (function () {
    var pills = document.querySelectorAll('.ksk-filter-pill');
    var items = document.querySelectorAll('.ksk-gallery-item');
    var emptyMsg = document.querySelector('.ksk-gallery-empty-filtered');

    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        pills.forEach(function (p) { p.classList.remove('active'); });
        pill.classList.add('active');

        var filter = pill.getAttribute('data-filter');
        var visibleCount = 0;

        items.forEach(function (item) {
          var match = filter === 'all' || item.getAttribute('data-category') === filter;
          item.style.display = match ? '' : 'none';
          if (match) visibleCount++;
        });

        if (emptyMsg) emptyMsg.hidden = visibleCount !== 0;
      });
    });

    var lightbox = document.getElementById('kskLightbox');
    var lightboxImg = document.getElementById('kskLightboxImg');
    var lightboxCaption = document.getElementById('kskLightboxCaption');
    var closeBtn = document.getElementById('kskLightboxClose');

    document.querySelectorAll('.ksk-gallery-thumb-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        lightboxImg.src = btn.getAttribute('data-full');
        lightboxImg.alt = btn.getAttribute('aria-label') || '';
        lightboxCaption.textContent = btn.getAttribute('data-caption') || '';
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
      });
    });

    function closeLightbox() {
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxImg.src = '';
    }

    closeBtn.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', function (e) {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeLightbox();
    });
  })();
</script>
