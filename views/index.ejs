    }

    .programs-preview .program-card {
        min-width: 0;
        height: 100%;
    }

    .programs-preview .program-card img {
        width: 100%;
        height: 220px;
        object-fit: cover;
    }

    .programs-preview .program-card-content {
        height: calc(100% - 220px);
        box-sizing: border-box;
    }

    @media (max-width: 900px) {
        .programs-preview .program-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
