<!-- Testimonials Preview -->
<section class="section testimonials">
    <div class="container">
        <p class="eyebrow center">Testimonials</p>

        <h2 class="center">
            What Our Students Say
        </h2>

        <p class="center max-w">
            We are collecting short reflections from Season VIII graduates
            and Kaizen alumni. Participant voices will be featured here
            as they become available.
        </p>

        <% if (typeof testimonials !== 'undefined' && testimonials && testimonials.length) { %>
            <div class="testimonial-grid">
                <% testimonials.slice(0, 3).forEach(function(t) { %>
                    <blockquote class="testimonial-card">
                        <img
                            class="avatar"
                            src="/images/images2.jpg"
                            alt="<%= t.name %>"
                        >

                        <p>
                            &ldquo;<%= t.quote %>&rdquo;
                        </p>

                        <footer>
                            <strong><%= t.name %></strong>
                            &mdash;
                            <%= t.role %>
                        </footer>
                    </blockquote>
                <% }); %>
            </div>
        <% } else { %>
            <div class="testimonial-grid">
                <blockquote class="testimonial-card">
                    <p>
                        Alumni voices from KSK Foundation's youth programs
                        will be featured here soon.
                    </p>
                    <footer>
                        <strong>KSK Foundation Alumni</strong>
                        &mdash; Coming Soon
                    </footer>
                </blockquote>

                <blockquote class="testimonial-card">
                    <p>
                        Participant stories will highlight the leadership,
                        enterprise and innovation journeys shaped through
                        our programs.
                    </p>
                    <footer>
                        <strong>Program Participants</strong>
                        &mdash; Coming Soon
                    </footer>
                </blockquote>

                <blockquote class="testimonial-card">
                    <p>
                        Follow our updates for new graduate and alumni
                        reflections.
                    </p>
                    <footer>
                        <strong>KSK Foundation</strong>
                        &mdash; Alumni Voices
                    </footer>
                </blockquote>
            </div>
        <% } %>

        <div class="center testimonials-more">
            <a href="/testimonials" class="btn btn-outline">
                Read Alumni Voices
            </a>
        </div>
    </div>
</section>




<%- include('partials/newsletter-signup', {
    variant: 'full',
    newsletterSource: 'homepage'
}) %>



<!-- Quarterly Update Sign-up -->
<section class="section newsletter-band" id="newsletter">
    <div class="container newsletter-inner">
        <div class="newsletter-copy">
            <p class="eyebrow">Quarterly Update</p>

            <h2>Stay close to the impact.</h2>

            <p>
                Get our Quarterly Update straight to your inbox — new
                cohorts, graduation highlights, partnership opportunities
                and FOCUS Magazine releases.
            </p>
        </div>

        <form action="/subscribe" method="POST" class="newsletter-form">
            <div class="form-row">
                <label for="newsletter-name">Full Name</label>
                <input
                    type="text"
                    id="newsletter-name"
                    name="name"
                    placeholder="Your full name"
                    required
                >
            </div>

            <div class="form-row">
                <label for="newsletter-email">Email Address</label>
                <input
                    type="email"
                    id="newsletter-email"
                    name="email"
                    placeholder="you@example.com"
                    required
                >
            </div>

            <div class="form-row">
                <label for="newsletter-role">I am a...</label>
                <select id="newsletter-role" name="role" required>
                    <option value="" selected disabled>Select one</option>
                    <option value="prospective-sponsor">Prospective Sponsor</option>
                    <option value="parent">Parent</option>
                    <option value="alumnus">Alumnus</option>
                    <option value="school">School</option>
                    <option value="other">Other</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Subscribe
            </button>

            <small class="newsletter-note">
                You can unsubscribe at any time. Subscription confirmation
                should be completed through double opt-in email.
            </small>
        </form>
    </div>
</section>

